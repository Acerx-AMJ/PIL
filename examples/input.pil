; input name and age application. feel free to add more
; things to read from the user.
main()
   print "Input your name: "
   readln $0
   goto main-input-age

main-input-age-error:
   print "Invalid input, try again. "

main-input-age:
   print "Input your age: "
   readln $1
   to-int $1, $2
   string-free $1
   is-null $2, $3
   jmp $3 main-input-age-error
   leeq $2, 0, $4
   greq $2, 120, $5
   or $4, $5, $6
   jmp $6, main-input-age-error
   incr $2

   printfln "Hello, {}! You will be {} next year!", $0, $2
   string-free $0
