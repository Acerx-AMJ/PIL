move-to-zero(n) let cond, tmp
   gr n, 0, cond
   jmp cond, move-to-zero-positive
   le n, 0, cond
   jmp cond, move-to-zero-negative
   return 0   
move-to-zero-positive:
   add n, -1, tmp
   return tmp
move-to-zero-negative:
   add n, 1, tmp
   return tmp

imul(a, b) let r, c, sa, cond
   set r, 0
   set c, b
   set sa a
   greq b, 0, cond
   jmp cond, imul-loop
   neg sa, sa
imul-loop:
   eq c, 0, cond
   jmp cond, imul-end
   add sa, r, r
   move-to-zero c
   set c, R$0
   goto imul-loop
imul-end:
   return r

main()
   imul 9, 8
   printn R$0
   imul -2, 4
   printn R$0
   imul -4, -5
   printn R$0
   imul 4, -2
   printn R$0
