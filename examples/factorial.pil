factorial(n) let minus1, result
   leeq n, 1, $0
   jmp $0, factorial-end

   sub n, 1, minus1
   call result, factorial, minus1
   mul result, n, result
   return result
factorial-end:
   return 1

factorial-iterative(n)
   leeq n, 1, $0
   jmp $0, factorial-iterative-end

   sub n, 1, $0
factorial-iterative-loop:
   mul n, $0, n
   sub $0, 1, $0
   gr $0, 1, $1
   jmp $1, factorial-iterative-loop
   return n
factorial-iterative-end:
   return 1

main()
   factorial 20.0
   printn R$0
