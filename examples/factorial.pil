; this file contains 2 factorial implementations.
factorial(n)
   leeq n, 1, $0
   jmp $0, factorial-end

   sub n, 1, $1
   factorial, $1
   mul R$0, n, R$0
   return R$0
factorial-end:
   return 1

factorial-iterative(n)
   leeq n, 1, $0
   jmp $0, factorial-iterative-end

   sub n, 1, $0
factorial-iterative-loop:
   mul n, $0, n
   decr $0
   gr $0, 1, $1
   jmp $1, factorial-iterative-loop
   return n
factorial-iterative-end:
   return 1

; test here
main()
   factorial 20.0
   printn R$0
