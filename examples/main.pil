print-array(arr) let i, n
   array-size arr, n
   printfn "Array size {}:", n
   set 0, i
   le i, n, $0
   jmp $0, print-array-loop
   return
print-array-loop:
   array-idx arr, i, $0
   printn '\'', $0, '\''
   incr i
   le i, n, $0
   jmp $0, print-array-loop

main() let a, b, c, d, n, i
   array-new a, 1
   array-set a, 0, a ; beware, the infinite array
   array-deep-copy a, b
   array-push a, 20
   array-push a, "hello"

   eq a, b, $0
   printfn "{} == {}? {}", a, b, $0

   array-free-marked 0
   string-free-marked 0
