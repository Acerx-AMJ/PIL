fib(n)
   leeq n, 1, $0
   jmp $0, fib-branch

   let nMinus1, nPlus1, fib1, fib2, result
   sub n, 1, nMinus1
   add n, 1, nPlus1

   call fib1, fib, nMinus1
   call fib2, fib, nPlus1
   add fib1, fib2, result
   return result

fib-branch:
   return n

main()
   global N 20
   call $0, fib, N
   print $0
