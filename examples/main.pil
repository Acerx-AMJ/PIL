print-array(arr) let i, n
   array-size arr, n
   printfn "Array size {}:", n
   set 0, i
   le i, n, $0
   jmp $0, print-array-loop
   return
print-array-loop:
   array-idx arr, i, $0
   printn '\'', $0, '\''
   incr i
   le i, n, $0
   jmp $0, print-array-loop

main() let a, b, c, d, n, i
   string-new a, "12312312312312312312this is my hidden message3123123123123123123123123123123123"
   string-find-last-not-of a, "123", b
   string-idx a, b, c
   printn b, c
   array-free-marked 0
   string-free-marked 0
