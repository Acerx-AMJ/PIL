@return-reg-size 8

print-call(f, a, b)
   func-call f, a, b
   return-count $0
   return-reg-size $1
   printfn "{}/{} returned values:", $0, $1

   set 0, $2
   le $2, $0, $3
   jmpn $3, print-call-end
print-call-start:
   return-reg-idx $2, $4
   printfn "[{}] = {}", $2, $4
   incr $2
   le $2, $0, $3
   jmp $3, print-call-start
print-call-end:

print-array(arr) let i, n
   array-size arr, n
   printfn "Array size {}:", n
   set 0, i
   le i, n, $0
   jmp $0, print-array-loop
   return
print-array-loop:
   array-idx arr, i, $0
   printn '\'', $0, '\''
   incr i
   le i, n, $0
   jmp $0, print-array-loop

my-func(a, b) let c, d, e, f
   add a, b, c
   sub a, b, d
   mul a, b, e
   div a, b, f
   return a, b, c, d, e, f

main() let a, b, c, d, n, i, s1, s2, s3, a1, a2
   string-new s1, "string1"
   string-new s2, "string2"
   string-new s3, "string3"
   array-new a1, s1, s2, s3, s1, s2, s3
   array-deep-copy a1, a2

   printn a1
   printn a2

   array-deep-free a1

