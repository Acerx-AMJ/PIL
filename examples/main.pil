list(a, ...) let count, i
   variadic-count count
   set 0, i
   printfn "{} ({} elements): ", a, count
   greq i, count, $0
   jmpn $0, list-loop
   return
list-loop:
   variadic-idx i, $0
   printn "* ", $0
   incr i
   greq i, count, $0
   jmpn $0, list-loop
   return

main()
   list "my-list"
   list "my-second-list", 1, 2, 3
   list "my-third-list", 5, 3, 90, "hi", main, list-loop, 243.43, '\t'
