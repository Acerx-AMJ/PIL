fib(n)
   leeq n, one, $1
   jmp $1, fib-branch

   let nMinus1, nPlus1, fib1, fib2, result
   sub n, 1, nMinus1
   add n, 1, nPlus1

   call fib1, fib, nMinus1
   call fib2, fib, nPlus1
   add fib1, fib2, result
   return result

fib-branch:
   return n

main()
   global one 1 ; stupid example
   global twenty 20 ; another stupid example

   call $1, fib, twenty
   print $1
